# Railway MySQL
# Preferred: paste Railway's MYSQL_URL reference/value. When present it takes
# precedence over the individual variables below.
# MYSQL_URL=mysql://user:password@host:port/database
# MYSQL_PUBLIC_URL= and DATABASE_URL= are also accepted, as are Railway's native MYSQLHOST,
# MYSQLPORT, MYSQLUSER, MYSQLPASSWORD and MYSQLDATABASE variables.

# Public proxy (use from local dev / this machine):
MYSQL_HOST=sakura.proxy.rlwy.net
MYSQL_PORT=50705
# Internal (use only inside the Railway network):
# MYSQL_HOST=mysql.railway.internal
# MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_a_rotated_password
MYSQL_DB=railway

# JWT secrets — generate your own strong values
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# CMS owner used by the migration/bootstrap flow
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace_with_a_long_unique_password
# Development only. Keep false in production; temporary passwords must travel by email.
ALLOW_TEMPORARY_PASSWORD_RESPONSE=false

# Frontend and invitation URLs (Firebase App Hosting in production)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3333

# SMTP (Nodemailer) — configure ONLY on Railway, never on Firebase.
# Railway Free/Trial/Hobby blocks outbound SMTP (587/465) → Connection timeout.
# Use Railway Pro + redeploy for Gmail SMTP, or an HTTPS email API on lower plans.
# Docs: https://docs.railway.com/networking/outbound-networking
# Gmail example (requires 2FA + App Password from Google Account > Security):
# SMTP_SERVICE=gmail
# SMTP_USER=compacting.news@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAIL_FROM=Compacting <compacting.news@gmail.com>
# APP_URL=https://compacting-web--compacting-next.europe-west4.hosted.app
#
# Generic SMTP (e.g. dominios.pt) — omit SMTP_SERVICE and set host/port instead:
# SMTP_HOST=mail.compacting.pt
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=newsletter@compacting.pt
# SMTP_PASSWORD=your-mailbox-password
# EMAIL_FROM=Compacting <newsletter@compacting.pt>
#
# Legacy variable name (supported if EMAIL_FROM is empty):
# SMTP_FROM=Compacting <newsletter@example.com>

# Railway Bucket (S3-compatible)
API_PUBLIC_URL=http://localhost:3333
STORAGE_ENDPOINT=https://replace-with-your-storage-endpoint
STORAGE_BUCKET=replace-with-your-bucket-name
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=replace-with-your-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-your-secret-key
# The service also accepts Railway's native ENDPOINT, BUCKET, REGION,
# ACCESS_KEY_ID and SECRET_ACCESS_KEY variable names.

# Optional SMTP. Sending stays disabled when these values are empty.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Compacting <newsletter@example.com>

# Contact form team notification (requires SMTP above)
CONTACT_NOTIFY_EMAIL=geral@compacting.pt
